<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1766314644806-1" author="Aleksei">
        <createTable tableName="account_info">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="phone" type="varchar(12)"/>
            <column name="photo" type="text"/>
            <column name="about" type="text"/>
            <column name="city" type="text"/>
            <column name="country" type="text"/>
            <column name="bd" type="date"/>
            <column name="photo_name" type="text"/>
            <column name="emoji_status" type="text"/>
            <column name="acc_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="account_info" baseColumnNames="acc_id" constraintName="fk_account_info_account"
                                 referencedTableName="account"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>